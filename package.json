{
    "name": "letterfast",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "dependencies": {
        "sliftutils": "^1.2.39"
    },
    "scripts": {
        "server": "yarn typenode ./web/server.ts",
        "host": "yarn typenode ./scripts/host.ts",
        "type": "yarn tsc --noEmit",
        "test": "yarn typenode ./scripts/test.ts",
        "build-words": "node scripts/buildWordsJS.js",
        "build-web": "node scripts/writeBuildVersion.js && yarn build-words && build-web --indexHtml ./index.html",
        "watch-web": "slift-watch --port 9887 \"web/*.ts\" \"web/*.tsx\" \"yarn build-web\"",
        "watch": "yarn watch-web",
        "build": "yarn build-web",
        "upload-words": "yarn build-words && node scripts/uploadWords.js",
        "deploy-server": "node scripts/deployServer.js",
        "deploy-letterquick": "node scripts/deployServer.js a.querysubtest.com",
        "deploy-claude": "git add -A && (git diff --cached --quiet || git commit -m \"Deploy\") && git push origin main"
    },
    "resolutions": {
        "preact": "npm:preact-old-types@*",
        "@cbor-extract/cbor-extract-win32-x64": "2.2.1"
    }
}
