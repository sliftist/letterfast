{
    "name": "letterfast",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "dependencies": {
        "sliftutils": "^1.2.2"
    },
    "scripts": {
        "server": "yarn typenode ./web/server.ts",
        "type": "yarn tsc --noEmit",
        "build-words": "node scripts/buildWordsJS.js",
        "build-web": "yarn build-words && build-web --indexHtml ./index.html",
        "watch-web": "slift-watch --port 9877 \"web/*.ts\" \"web/*.tsx\" \"yarn build-web\"",
        "watch": "yarn watch-web",
        "build": "yarn build-web",
        "upload-words": "yarn build-words && node scripts/uploadWords.js",
        "deploy-static": "local-deploy-static.bat",
        "d": "yarn deploy-static",
        "deploy-server": "local-deploy-server.bat",
        "deploy-app": "local-deploy-app.bat",
        "deploy": "local-deploy-static.bat && local-deploy-app.bat",
        "deploy-static-mac": "bash local-deploy-static.sh",
        "d-mac": "yarn deploy-static-mac",
        "deploy-server-mac": "bash local-deploy-server.sh",
        "deploy-app-mac": "bash local-deploy-app.sh",
        "deploy-mac": "bash local-deploy-static.sh && bash local-deploy-app.sh"
    },
    "resolutions": {
        "preact": "npm:preact-old-types@*",
        "@cbor-extract/cbor-extract-win32-x64": "2.2.1"
    }
}