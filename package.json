{
    "name": "letterfast",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "dependencies": {
        "sliftutils": "^1.2.2",
        "socket-function": "*"
    },
    "scripts": {
        "server": "yarn typenode ./web/server.ts",
        "type": "yarn tsc --noEmit",
        "build-web": "build-web",
        "watch-web": "slift-watch --port 9877 \"web/*.ts\" \"web/*.tsx\" \"yarn build-web\""
    },
    "resolutions": {
        "preact": "npm:preact-old-types@*"
    }
}